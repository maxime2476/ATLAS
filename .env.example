# Modèle de fichier d'environnement. Copier en `.env` (non versionné) et renseigner localement.
# Aucune valeur réelle ne doit être versionnée.

# Jeton NASA Earthdata (https://urs.earthdata.nasa.gov/), requis seulement pour l'extension NDVI (MODIS/VIIRS).
EARTHDATA_TOKEN=

# Jeton AppEEARS (valable ~48 h), obtenu par POST /api/login avec les identifiants Earthdata.
# AppEEARS n'accepte pas EARTHDATA_TOKEN. Le mot de passe Earthdata n'est jamais stocké.
APPEEARS_TOKEN=

# Compte DRIAS (projections D1 et DRIAS-Eau, scripts 37 et 41). Ces identifiants sont stockés en clair dans `.env`,
# qui n'est jamais versionné : utiliser un mot de passe propre à ce service.
DRIAS_LOGIN=
DRIAS_PASSWORD=
